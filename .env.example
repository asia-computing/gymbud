# Where signups are recorded. Currently the /exec URL of the Google Apps Script
# Web App in `scripts/gymbud-signups.gs` — see that file for deploy steps.
#
# Local dev: copy this file to `.env` and fill it in.
# Production: set it as an Actions variable named VITE_SIGNUP_ENDPOINT
# (Settings ▸ Secrets and variables ▸ Actions ▸ Variables).
VITE_SIGNUP_ENDPOINT=
