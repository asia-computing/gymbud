{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "GYMBUD design tokens. W3C-style",
  "color": {
    "bg":            { "$value": "#EEE7DA", "$type": "color", "$description": "Page / canvas — warm cream" },
    "paper":         { "$value": "#FFFFFF", "$type": "color", "$description": "Card / input surface" },
    "paper2":        { "$value": "#F5F0E5", "$type": "color" },
    "ink":           { "$value": "#111110", "$type": "color", "$description": "Primary text + primary button" },
    "ink2":          { "$value": "#1F1E1B", "$type": "color" },
    "muted":         { "$value": "#6E665A", "$type": "color", "$description": "Secondary text" },
    "hair":          { "$value": "rgba(31,30,27,0.08)", "$type": "color", "$description": "1 px borders" },
    "accent": {
      "base":        { "$value": "#D6F23E", "$type": "color", "$description": "“You” accent — lime" },
      "ink":         { "$value": "#161800", "$type": "color" },
      "soft":        { "$value": "#F1F8C2", "$type": "color" }
    },
    "accent2": {
      "base":        { "$value": "#FF6A47", "$type": "color", "$description": "“Your bud” accent — coral" },
      "ink":         { "$value": "#2A0A00", "$type": "color" },
      "soft":        { "$value": "#FFE0D4", "$type": "color" }
    },
    "tint": {
      "weight":      { "$value": "#E8E0CE", "$type": "color" },
      "cali":        { "$value": "#D6F23E", "$type": "color" },
      "run":         { "$value": "#FFD7C2", "$type": "color" },
      "jog":         { "$value": "#E7E1D2", "$type": "color" },
      "walk":        { "$value": "#DCEEDD", "$type": "color" },
      "boulder":     { "$value": "#FF6A47", "$type": "color" },
      "swim":        { "$value": "#C8DEF2", "$type": "color" },
      "yoga":        { "$value": "#EBD7F2", "$type": "color" }
    },
    "status": {
      "success":     { "$value": "#2E8B4A", "$type": "color" },
      "danger":      { "$value": "#C0392B", "$type": "color" },
      "warning":     { "$value": "#D68B00", "$type": "color" }
    }
  },
  "radius": {
    "xs":   { "$value": "8px",   "$type": "dimension" },
    "sm":   { "$value": "12px",  "$type": "dimension" },
    "md":   { "$value": "16px",  "$type": "dimension" },
    "lg":   { "$value": "20px",  "$type": "dimension" },
    "xl":   { "$value": "24px",  "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "space": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },
  "size": {
    "hit":        { "$value": "44px", "$type": "dimension", "$description": "Min tap target" },
    "input":      { "$value": "56px", "$type": "dimension" },
    "btn-lg":     { "$value": "56px", "$type": "dimension" },
    "btn-md":     { "$value": "46px", "$type": "dimension" },
    "btn-sm":     { "$value": "38px", "$type": "dimension" }
  },
  "shadow": {
    "1": { "$value": "0 1px 3px rgba(0,0,0,0.04), 0 2px 6px rgba(0,0,0,0.03)",    "$type": "shadow" },
    "2": { "$value": "0 6px 16px -4px rgba(0,0,0,0.08), 0 2px 4px rgba(0,0,0,0.04)", "$type": "shadow" },
    "3": { "$value": "0 12px 36px -8px rgba(0,0,0,0.18), 0 4px 10px rgba(0,0,0,0.06)", "$type": "shadow" }
  },
  "motion": {
    "ease":     { "$value": "cubic-bezier(0.2, 0.7, 0.2, 1)",  "$type": "cubicBezier" },
    "ease-out": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)",   "$type": "cubicBezier" },
    "dur-1":    { "$value": "120ms", "$type": "duration", "$description": "Press / tap" },
    "dur-2":    { "$value": "180ms", "$type": "duration", "$description": "Hover, toggle" },
    "dur-3":    { "$value": "280ms", "$type": "duration", "$description": "Screen fade" }
  },
  "font": {
    "family": {
      "display": { "$value": "Bricolage Grotesque, system-ui, sans-serif", "$type": "fontFamily" },
      "body":    { "$value": "Inter, system-ui, sans-serif",                "$type": "fontFamily" },
      "mono":    { "$value": "JetBrains Mono, ui-monospace, monospace",      "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" },
      "black":    { "$value": 800, "$type": "fontWeight" }
    },
    "size": {
      "display-xxl": { "$value": "84px", "$type": "dimension" },
      "display-xl":  { "$value": "56px", "$type": "dimension" },
      "display-lg":  { "$value": "36px", "$type": "dimension" },
      "display-md":  { "$value": "28px", "$type": "dimension" },
      "display-sm":  { "$value": "22px", "$type": "dimension" },
      "body-lg":     { "$value": "17px", "$type": "dimension" },
      "body":        { "$value": "15px", "$type": "dimension" },
      "body-sm":     { "$value": "13px", "$type": "dimension" },
      "label":       { "$value": "11px", "$type": "dimension" },
      "caption":     { "$value": "12px", "$type": "dimension" }
    }
  },
  "themes": {
    "dusk-coral": {
      "color.bg":          { "$value": "#F4ECE4", "$type": "color" },
      "color.ink":         { "$value": "#1B1A18", "$type": "color" },
      "color.muted":       { "$value": "#73685D", "$type": "color" },
      "color.accent.base": { "$value": "#FF6A47", "$type": "color" },
      "color.accent2.base":{ "$value": "#0E2EFF", "$type": "color" }
    },
    "midnight-neon": {
      "color.bg":          { "$value": "#0E0E10", "$type": "color" },
      "color.paper":       { "$value": "#17171A", "$type": "color" },
      "color.ink":         { "$value": "#F4F2EC", "$type": "color" },
      "color.muted":       { "$value": "#888378", "$type": "color" },
      "color.accent.base": { "$value": "#C6FF3D", "$type": "color" },
      "color.accent2.base":{ "$value": "#FF3D8A", "$type": "color" }
    },
    "court-cobalt": {
      "color.bg":          { "$value": "#EDEDE6", "$type": "color" },
      "color.ink":         { "$value": "#101015", "$type": "color" },
      "color.muted":       { "$value": "#5F5F69", "$type": "color" },
      "color.accent.base": { "$value": "#1B3CFF", "$type": "color" },
      "color.accent2.base":{ "$value": "#FFC83D", "$type": "color" }
    }
  }
}
